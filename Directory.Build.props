<Project>
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <!-- One mod commit/build is compiled and behaviorally verified against exactly one KSA build. -->
    <VerifiedKsaBuild>2026.9.7.5402</VerifiedKsaBuild>
  </PropertyGroup>
</Project>

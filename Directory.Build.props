<Project>
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <!-- One mod commit/build supports exactly the KSA build it was compiled and verified against. -->
    <VerifiedKsaBuild>2026.7.8.4980</VerifiedKsaBuild>
  </PropertyGroup>
</Project>
